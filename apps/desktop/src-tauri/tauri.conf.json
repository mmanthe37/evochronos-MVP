{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "EvoChronos",
  "version": "0.1.0",
  "identifier": "org.evochronos.desktop",
  "build": {
    "frontendDist": "../../workbench/dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm --prefix ../workbench run dev",
    "beforeBuildCommand": "npm --prefix ../workbench run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EvoChronos — Evolutionary Sandbox Workstation",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
